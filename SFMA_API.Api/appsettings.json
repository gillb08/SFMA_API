{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=<NEON_HOST>;Port=5432;Database=<DATABASE>;Username=<USERNAME>;Password=<PASSWORD>;SSL Mode=Require;Trust Server Certificate=true"
  },
  "DatabaseConfig": {
    "Server": "<NEON_HOST>",
    "Port": 5432,
    "Database": "<DATABASE>",
    "UserId": "<USERNAME>",
    "Password": "<PASSWORD>",
    "SslMode": "Require"
  },
  "JwtConfig": {
    "Secret": "SuperSecretKeyForSFMAStFaithModelAcademyPortal2026JWTSigningMustBeLongEnough123456!",
    "Issuer": "SFMA_API",
    "Audience": "SFMA_API_Users",
    "AccessTokenExpirationMinutes": 120,
    "RefreshTokenExpirationDays": 30
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  },
  "SeedData": {
    "SuperAdmin": {
      "FirstName": "Super",
      "LastName": "Admin",
      "Email": "admin@sfma.edu.ng",
      "UserName": "admin@sfma.edu.ng",
      "Password": "Password@123"
    }
  },
  "SchoolSettings": {
    "EmailDomain": "stfaithacademy.edu.ng",
    "StudentCodePrefix": "SF",
    "TokenProviderName": "SFMA",
    "SupervisorRoles": [ "super_admin", "principal", "vice_principal_acad" ],
    "PortalRoutes": {
      "super_admin": "/portal/admin",
      "academic_admin": "/portal/academic-admin",
      "financial_admin": "/portal/bursary",
      "academic_head": "/portal/academic-head",
      "financial_head": "/portal/financial-head",
      "teacher": "/portal/teacher",
      "parent": "/portal/parent",
      "student": "/portal/student"
    },
    "GradingScale": [
      { "MinScore": 75, "Grade": "A+" },
      { "MinScore": 70, "Grade": "A" },
      { "MinScore": 60, "Grade": "B" },
      { "MinScore": 50, "Grade": "C" },
      { "MinScore": 40, "Grade": "D" },
      { "MinScore": 0,  "Grade": "F" }
    ],
    "PassMarkThreshold": 50,
    "QualityAssuranceVettingThreshold": 80,
    "DefaultDepartmentBudget": 0
  }
}
